# 44mesh Monitoring Stack Configuration
# Copy to .env and fill in ALL values — no defaults are provided.

# --- Monitoring infrastructure (where VictoriaMetrics + Grafana live) ---

# Docker network that VictoriaMetrics is on (so process-exporter can be scraped)
MONITORING_NETWORK=sai-monitoring_default

# Base directory of the monitoring stack on the server
MONITORING_BASE_DIR=/opt/sai-monitoring

# Grafana container name (restarted after config updates)
GRAFANA_CONTAINER=sai-grafana

# VictoriaMetrics datasource UID in Grafana (used in dashboard + alert rules)
GRAFANA_DATASOURCE_UID=P4169E866C3094E38

# Bridge gateway IP of the monitoring Docker network
# (VictoriaMetrics uses this to reach host-network containers)
VM_BRIDGE_GATEWAY=172.21.0.1

# VictoriaMetrics API port on localhost (for hot-reload and scrape config)
VM_PORT=8428

# --- mesh-watchdog settings ---

WATCHDOG_PORT=9257
# Address to bind the watchdog HTTP server on.
# Use the Docker bridge gateway IP so only VictoriaMetrics can reach it,
# not the public internet.
LISTEN_ADDR=172.21.0.1
COLLECT_INTERVAL=15

# Netmaker API (as seen from host network)
NETMAKER_API_URL=http://127.0.0.1:8443

# MQTT broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# DNS test targets
DNS_TEST_DOMAIN=google.com
DNS_TEST_INTERNAL=netmaker.altermundi.net
