FROM node:18-bookworm

RUN apt-get update && apt-get install -y \
    git \
    python3 \
    make \
    g++ \
    curl \
  && rm -rf /var/lib/apt/lists/*

# AlterMundi fork with full network field edit UI
WORKDIR /opt/altermundi
RUN git clone --branch v0.0.9-altermundi https://github.com/altermundi/zerotier-ui /opt/altermundi/zerotier-ui

WORKDIR /opt/altermundi/zerotier-ui/src
RUN npm install

WORKDIR /opt/altermundi/zerotier-ui/src
RUN cp -v etc/default.passwd etc/passwd

COPY ztncui-entrypoint.sh /usr/local/bin/ztncui-entrypoint.sh
RUN chmod +x /usr/local/bin/ztncui-entrypoint.sh

ENV NODE_ENV=production
ENV ZT_ADDR=127.0.0.1:9993
ENV ZTNCUI_HTTP_PORT=3180
ENV ZTNCUI_HTTPS_PORT=
ENV ZTNCUI_HTTP_ALL_INTERFACES=
ENV ZTNCUI_HTTPS_HOST=
ENV ZTNCUI_PASSWD=

EXPOSE 3180
EXPOSE 3443

ENTRYPOINT ["/usr/local/bin/ztncui-entrypoint.sh"]
